#!/bin/sh
# wmclock integre au Front Panel (controle Clock, voir ~/.dt/types/Clock.fp).
# Un clic sur l'applet ouvre Google Agenda dans Firefox.
pgrep -u "$(id -u)" -x wmclock >/dev/null ||
    /usr/bin/wmclock -24 -exe '/usr/bin/firefox https://calendar.google.com' &

# Moniteurs integres au Front Panel (controles WmCpuLoad, WmMemLoad, WmBattery).
pgrep -u "$(id -u)" -x wmcpuload >/dev/null || /usr/bin/wmcpuload -w &
pgrep -u "$(id -u)" -x wmmemload >/dev/null || "$HOME/.dt/wmmemload-panel.sh" &
pgrep -u "$(id -u)" -x wmbattery >/dev/null || wmbattery &

# Reaffiche wmcpuload et wmmemload apres un redemarrage du workspace manager.
pgrep -u "$(id -u)" -f '^/bin/sh .*panel-applets-watch' >/dev/null || "$HOME/.dt/panel-applets-watch.sh" &

# xeyes integre au Front Panel (controle XEyes), fond couleur du panneau.
pgrep -u "$(id -u)" -x xeyes >/dev/null || "$HOME/.dt/xeyes-panel.sh" &

# Zone de notification integree au Front Panel (controle Tray), puis l'applet reseau.
pgrep -u "$(id -u)" -x stalonetray >/dev/null || "$HOME/.dt/tray-panel.sh" &
pgrep -u "$(id -u)" -x nm-applet >/dev/null || { sleep 3; nm-applet; } &

# Dropbox (synchronisation de ~/Dropbox).
pgrep -u "$(id -u)" -x dropbox >/dev/null || "$HOME/.dropbox-dist/dropboxd" &

# Bluetooth dans la zone de notification.
pgrep -u "$(id -u)" -f 'blueman-applet' >/dev/null || { sleep 4; blueman-applet; } &

# Historique du presse-papiers dans la zone de notification.
pgrep -u "$(id -u)" -x xfce4-clipman >/dev/null || { sleep 4; xfce4-clipman; } &

# Gestionnaire d'alimentation (bouton marche/arret, capot, inactivite, ecran).
# Lance ici car dtsession ne le reenregistre pas quand il est relance a la main.
pgrep -u "$(id -u)" -x xfce4-power-man >/dev/null || xfce4-power-manager &

# Verrou CDE avant chaque mise en veille (une seule copie)
pgrep -u "$(id -u)" -f lock-on-sleep.py >/dev/null || "$HOME/.dt/lock-on-sleep.py" &
