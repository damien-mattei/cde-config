ACTION GnomeTerminal
{
     LABEL         GnomeTerminal
     TYPE          COMMAND
     EXEC_STRING   /usr/bin/gnome-terminal
     ICON          GnomeTerminal
     WINDOW_TYPE   NO_STDIO
     DESCRIPTION   Gnome Terminal
}

