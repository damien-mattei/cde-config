ACTION Power_settings
{
     LABEL         Power settings
     TYPE          COMMAND
     EXEC_STRING   /usr/bin/xfce4-power-manager-settings
     ICON          Power settings
     WINDOW_TYPE   NO_STDIO
     DESCRIPTION   Réglages d'alimentation
}

