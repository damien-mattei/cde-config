ACTION XFCE_Terminal
{
     LABEL         XFCE_Terminal
     TYPE          COMMAND
     EXEC_STRING   /usr/bin/xfce4-terminal
     ICON          XFCE_Terminal
     WINDOW_TYPE   NO_STDIO
     DESCRIPTION   XFCE Terminal
}

