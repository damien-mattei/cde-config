CONTROL	Xload
{
   TYPE	file
   CONTAINER_TYPE	SUBPANEL
   CONTAINER_NAME	Clock
   POSITION_HINTS	last
   ICON	Dtload
   FILE_NAME	/usr/dt/appconfig/appmanager/C/Desktop_Tools/Xload
   HELP_STRING	The System Load (Xload) action displays a graphical view of the system load.  It uses the xload command.
}
